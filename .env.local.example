# ===== EquiHub environment variables =====
# Copy to .env.local and fill in real values.
# Anything left blank/placeholder will keep the app in mock mode.

# ===== Database (AWS RDS PostgreSQL in production) =====
DATABASE_URL="postgresql://user:password@equihub.xxxx.ap-southeast-1.rds.amazonaws.com:5432/equihub"
USE_MOCK_DB="true"

# ===== AWS (used by Cognito, S3, SES) =====
AWS_REGION="ap-southeast-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# ===== Cognito User Pool (production auth) =====
COGNITO_USER_POOL_ID=""
COGNITO_CLIENT_ID=""
COGNITO_CLIENT_SECRET=""

# ===== S3 Buckets =====
S3_BUCKET_DOCUMENTS="equihub-documents"
S3_BUCKET_PUBLIC="equihub-public"

# ===== SES (transactional email) =====
SES_FROM_EMAIL="noreply@equihub.com"

# ===== App =====
NEXTAUTH_SECRET="change-this-in-production"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
